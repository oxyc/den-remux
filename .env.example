# Runtime configuration for den-remux. The binary reads the process environment only (no .env loader):
# export these for `cargo run`; on the homelab they come from the den repo's deploy/ env files.
# SCOUT_INSTALL_URL, REMUX_URL_KEY and METRICS_TOKEN are secrets.

# PORT=8095

# The primary path: the web app sends the scout install URL from its library's plugin list with each
# POST /remux/session {scout}. It is accepted only on one of these origins (scheme://host[:port],
# comma-separated) — the SSRF guard. REMUX_SCOUT_KEY is sent to scout as X-Den-Remux-Key, which a
# scope=availability URL needs before it lists or plays; a full install URL doesn't.
# SCOUT_ORIGINS=http://192.168.86.193:8080
# REMUX_SCOUT_KEY=

# Fallback when a request names no scout: a den-scout install of this service's own, sealed config
# included, without /manifest.json. It lists and plays anything, so it is never logged and never leaves
# the process.
# SCOUT_INSTALL_URL=http://192.168.86.193:8080/<sealed-config>

# SHA-256 (hex) of each browser's key, comma-separated. A browser posts its key to /remux/login once.
# Make a key and its hash:  key=$(head -c 24 /dev/urandom | base64 | tr '+/' '-_'); printf %s "$key" | sha256sum
# BROWSER_KEY_HASHES=

# Signs the browser cookie and every session URL (any string). Rotating it logs every browser out and
# kills every session URL. Unset = a random key per process, so every restart logs the browsers out.
# REMUX_URL_KEY=

# Sessions playing at once (default 2). The next one gets 429.
# MAX_SESSIONS=2

# A session with no request for this long is ended and its ffmpeg killed (default 600; minimum 30).
# SESSION_IDLE_SECS=600

# Where GOP files are written while a session plays (the image sets /cache). Must be den-remux's alone:
# every s-* directory in it is deleted at start.
# SCRATCH_DIR=/cache

# Cap on scratch across all sessions; past it, a job pauses once the segment the player asked for is done
# (default 1 GiB; below 64 MiB falls back to the default).
# SCRATCH_MAX_BYTES=1073741824

# ffmpeg, when it is not on PATH under this name (the image sets its own).
# FFMPEG_PATH=ffmpeg

# Bearer token for GET /metrics (Prometheus text). Unset ⇒ the route answers 404.
# METRICS_TOKEN=

# One stderr line per response, `<METHOD> <path> <status> <ms>ms`, with the session signature removed
# and the session id shortened. Unset, empty or 0 ⇒ off.
# LOG_REQUESTS=0
